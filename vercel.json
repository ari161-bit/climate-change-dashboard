{
  "buildCommand": "python vercel_build.py",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{aptech-hadoop-eproject/**}",
      "excludeFiles": "{media/**,myshop/**,product_images/**,category_images/**,climate/**,docs/**,deploy/**,public/**,node_modules/**,.venv/**,aptech-hadoop-eproject/docs/**,aptech-hadoop-eproject/**/*.doc,aptech-hadoop-eproject/**/*.docx,**/*.rar,.git/**,.claude/**,**/__pycache__/**,**/tests/**,**/db.sqlite3,**/logs/**,**/keys/data.key}"
    }
  }
}
