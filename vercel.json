{
  "buildCommand": "python vercel_build.py",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{aptech-hadoop-eproject/**}",
      "excludeFiles": "{.venv/**,**/tests/**,media/**,myshop/**,product_images/**,category_images/**,climate/**,docs/**,deploy/**,public/**,.git/**,**/*.rar,**/*.doc*,**/__pycache__/**,**/db.sqlite3,**/logs/**,**/keys/data.key}"
    }
  }
}
