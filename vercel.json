{
  "buildCommand": "python vercel_build.py",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{aptech-hadoop-eproject/**}",
      "excludeFiles": "{**/*.rar,.git/**,.claude/**,**/__pycache__/**,**/db.sqlite3,**/logs/**,**/keys/data.key}"
    }
  }
}
